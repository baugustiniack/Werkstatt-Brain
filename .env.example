# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL (Stammdaten, Logs – Kap. 2.1) ─────────────────────────────────
POSTGRES_USER=werkstatt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=werkstatt_brain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://werkstatt:change-me@postgres:5432/werkstatt_brain

# ── Qdrant (Vektor-DB: cad_snippets, workshop_knowledge – Kap. 2.2) ──────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_VECTOR_SIZE=1024

# ── Redis (Queue / Cache – Kap. 1.5) ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── Cloud LLM APIs (Phase 1 – Kap. 1.2) ──────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: Cursor SDK Key (Dashboard → Integrations) für Concept Builder / 3D Builder
CURSOR_API_KEY=
# OPENAI_API_KEY wird auch für fotorealistische Konzept-Fotos (Images API) genutzt.

# ── Local LLM (Phase 2 – optional) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434

# ── LangGraph Agenten & Sandbox Execution Service (Kap. 3, 4) ───────────────
SANDBOX_TIMEOUT_SECONDS=20
AGENT_MAX_ITERATIONS=6
SANDBOX_DOCKER_IMAGE=werkstatt-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
API_CONTAINER_NAME=werkstatt-api

# ── Asset Crawler & Vision Ingestion (Kap. 2.3) ──────────────────────────────
CRAWLER_SCAN_PATHS=/data/crawler_input
CRAWLER_FILE_EXTENSIONS=.step,.stp,.stl,.f3d,.png,.jpg,.jpeg
UPLOADS_DIR=/data/uploads
VISION_MODEL=claude-3-5-sonnet-20241022

# ── Meta-Coach (Kap. 2.5) ────────────────────────────────────────────────────
META_COACH_RULES_DIR=/app/rules
META_COACH_SCHEDULER_ENABLED=false
META_COACH_NIGHTLY_HOUR=2

# ── Frontend / PWA (Kap. 5) ──────────────────────────────────────────────────
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173

# WLAN-IP des PCs für Handy-QR (kommagetrennt). Beispiel: 192.168.178.46
# LAN_HINT_IPS=192.168.178.46
